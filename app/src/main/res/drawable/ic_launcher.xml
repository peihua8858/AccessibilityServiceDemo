<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3C7FEC" />
            <corners android:radius="@dimen/dp_8" />
            <padding
                android:bottom="@dimen/dp_3"
                android:left="@dimen/dp_3"
                android:right="@dimen/dp_3"
                android:top="@dimen/dp_3" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/dp_3"
        android:end="@dimen/dp_3"
        android:start="@dimen/dp_3"
        android:top="@dimen/dp_3">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/dp_8" />
            <size
                android:width="@dimen/dp_32"
                android:height="@dimen/dp_32" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>